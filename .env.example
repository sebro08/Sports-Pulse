# Copia este archivo a .env y completa los valores. NUNCA subas .env a Git.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DOCS_ENABLED=true

DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_SSL=false

REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
CACHE_TTL_LIST_SECONDS=60
CACHE_TTL_DETAIL_SECONDS=120

# Auth (ADR-004). Local: a random secret of 32+ chars, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# then mint tokens with: npm run token -- --role ADMIN --sub your-name
# Production: leave the secret empty and set AUTH_JWKS_URL (e.g. Entra ID). With neither, admin endpoints return 401.
AUTH_JWT_SECRET=
AUTH_JWKS_URL=
AUTH_ISSUER=sports-pulse-local
AUTH_AUDIENCE=sports-pulse-api

# Rate limiting per client IP. TRUST_PROXY=true only behind a trusted ingress (reads X-Forwarded-For).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=60
TRUST_PROXY=false

SPORTS_API_KEY=
