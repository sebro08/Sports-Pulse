# Copia este archivo a .env y completa los valores. NUNCA subas .env a Git.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DOCS_ENABLED=true

DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_SSL=false

REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
CACHE_TTL_LIST_SECONDS=60
CACHE_TTL_DETAIL_SECONDS=120

SPORTS_API_KEY=
